{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/godspeed_ginny",
        "destination": "/lab/godspeed-ginny/index.html",
        "type": 302
      },
      {
        "source": "/godspeed_ginny/",
        "destination": "/lab/godspeed-ginny/index.html",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/ym/v2/**",
        "function": "ymApi"
      },
      {
        "source": "/api/km-analytics",
        "function": "kmAnalytics"
      },
      {
        "source": "/api/triptime",
        "function": "triptime"
      },
      {
        "source": "/mm/chart",
        "function": "mmChart"
      },
      {
        "source": "!/**/*.html",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "codebase": "default"
  }
}
